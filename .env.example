# Copy to .env and adjust as needed. The app reads these at startup.

# Frontend -> backend base URL.
#   local (no Docker): http://localhost:8000
#   docker compose:    http://backend:8000  (set automatically in compose)
BACKEND_URL=http://localhost:8000

# Backend data sources (override to point at different CSV files).
DEVICE_DATA_FILE=data/devices.csv
TEST_RUNS_FILE=data/test_runs.csv

# KPI tuning.
SLA_THRESHOLD_SEC=60
CALIBRATION_SOON_DAYS=30

# CORS allow-list for browser clients (comma-separated, "*" allows all).
CORS_ALLOW_ORIGINS=*
